#!/usr/bin/env python3
"""CIT-63: build five pinned Manrope subsets, or verify the committed assets."""
import argparse
import hashlib
import json
import re
import sys
import tempfile
from pathlib import Path

GATE = "Font provenance incomplete. Waiting for Oscar to pin google/fonts commit."
SOURCE_SHA = "3ae11c49db0455a3cc33e37d380f20fdb8c7f8b41dc07625c177e3d87a9d6ae6"
SOURCE_SIZE = 164700
SOURCE_COMMIT = "b31870aff700ab7a1d74fa0c6887d95beb9e0037"
LICENSE_SHA = "58172e0c0fac2cda8a37b348164bb55e44b0e69051e557e92b1d3f6910141f7b"
RANGES = {
    "latin": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-201F,U+2021-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
    "latin-ext": "U+0100-0130,U+0132-0151,U+0154-024F,U+0259,U+1E00-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF",
    "cyrillic": "U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116",
    "cyrillic-ext": "U+0460-048F,U+0492-04AF,U+04B2-052F,U+1C80-1C8F,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F",
    "greek": "U+0370-03FF,U+1F00-1FFF",
}


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError) as error:
        raise ValueError(GATE) from error


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def complete(record):
    return (isinstance(record, dict)
            and isinstance(record.get("sha256"), str)
            and re.fullmatch(r"[0-9a-f]{64}", record["sha256"])
            and type(record.get("bytes")) is int and record["bytes"] > 0
            and isinstance(record.get("google_fonts_commit"), str)
            and re.fullmatch(r"[0-9a-f]{40}", record["google_fonts_commit"]))


def source_gate(manifest, provenance):
    try:
        files = provenance["files"]
        font = next(x for x in files if x["file"].endswith("Manrope[wght].ttf"))
        license_record = next(x for x in files if x["file"].endswith("OFL.txt"))
        source = manifest["source"]
        license_entry = manifest["license"]
        for expected, actual in [(font, source), (license_record, license_entry)]:
            if not complete(expected) or not complete(actual):
                raise ValueError(GATE)
            if any(expected[k] != actual[k] for k in ("sha256", "bytes", "google_fonts_commit")):
                raise ValueError("Font manifest does not match Oscar's pinned provenance.")
        if source["google_fonts_commit"] != license_entry["google_fonts_commit"]:
            raise ValueError("Font and OFL must be pinned to the same google/fonts commit.")
        if source["sha256"] != SOURCE_SHA or source["bytes"] != SOURCE_SIZE:
            raise ValueError("Manrope source differs from Oscar's accepted 164,700-byte font.")
        if (source["google_fonts_commit"] != SOURCE_COMMIT
                or license_entry["sha256"] != LICENSE_SHA or license_entry["bytes"] != 4387):
            raise ValueError("Font provenance differs from the verified google/fonts pin.")
        return source
    except (KeyError, TypeError, StopIteration) as error:
        raise ValueError(GATE) from error


def verify_file(path, record):
    if not path.is_file() or path.stat().st_size != record["bytes"] or sha(path) != record["sha256"]:
        raise ValueError(f"Font asset missing or integrity mismatch: {path.name}")


def check_outputs(manifest, output):
    entries = manifest.get("outputs")
    if not isinstance(entries, list) or len(entries) != len(RANGES):
        raise ValueError(GATE)
    by_script = {entry.get("script"): entry for entry in entries if isinstance(entry, dict)}
    if set(by_script) != set(RANGES):
        raise ValueError(GATE)
    for script, unicode_range in RANGES.items():
        entry = by_script[script]
        if not complete(entry):
            raise ValueError(GATE)
        if (entry.get("file") != f"manrope-{script}.woff2"
                or entry.get("unicode_range") != unicode_range
                or entry.get("weight") != [400, 700]
                or entry["google_fonts_commit"] != manifest["source"]["google_fonts_commit"]):
            raise ValueError(f"Font subset contract mismatch: {script}")
        path = output / entry["file"]
        verify_file(path, entry)
        if path.read_bytes()[:4] != b"wOF2":
            raise ValueError(f"Font asset is not WOFF2: {path.name}")
    verify_file(output / "OFL.txt", manifest["license"])


def build(source_path, manifest, output):
    # Nothing is imported or generated until provenance passes. --check needs only Python.
    import fontTools
    from fontTools import subset
    from fontTools.ttLib import TTFont
    from fontTools.varLib.instancer import instantiateVariableFont
    if fontTools.__version__ != "4.60.1":
        raise ValueError("Install scripts/fonts/requirements.txt in a dedicated venv.")
    verify_file(source_path, manifest["source"])
    font = TTFont(source_path, recalcTimestamp=False)
    specimen = "șțıİąėįųūěščřžýáíéďťňľĺŕôäőűРусскийБългарскиΕλληνικάάέήίόύώ"
    missing = [char for char in specimen if ord(char) not in font.getBestCmap()]
    if missing:
        raise ValueError(f"Manrope specimen glyphs missing: {''.join(missing)}")
    # Preserve tnum and all shaping/localized features in every subset.
    if "tnum" not in {x.FeatureTag for x in font["GSUB"].table.FeatureList.FeatureRecord}:
        raise ValueError("Manrope has no tnum feature.")
    entries = []
    with tempfile.TemporaryDirectory(dir=output) as directory:
        for script, unicode_range in RANGES.items():
            face = TTFont(source_path, recalcTimestamp=False)
            options = subset.Options()
            options.layout_features = ["*"]
            options.harfbuzz_repacker = False
            subsetter = subset.Subsetter(options=options)
            subsetter.populate(unicodes=subset.parse_unicodes(unicode_range))
            subsetter.subset(face)
            # Subset before instancing: instancer removes empty gvar entries,
            # which the subsetter otherwise expects for every retained glyph.
            face = instantiateVariableFont(face, {"wght": (400, 700)}, inplace=True)
            if not face.getBestCmap():
                raise ValueError(f"Empty Manrope subset: {script}")
            face.flavor = "woff2"
            path = Path(directory) / f"manrope-{script}.woff2"
            face.save(path, reorderTables=True)
            entries.append({"script": script, "file": path.name, "unicode_range": unicode_range,
                            "weight": [400, 700], "sha256": sha(path), "bytes": path.stat().st_size,
                            "google_fonts_commit": manifest["source"]["google_fonts_commit"]})
        for entry in entries:
            (Path(directory) / entry["file"]).replace(output / entry["file"])
    manifest["outputs"] = entries
    manifest["status"] = "complete"
    (output / "fonts-manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    check_outputs(manifest, output)


def main():
    root = Path(__file__).resolve().parents[2]
    public = root / "Client/public" if (root / "Client/public").is_dir() else root / "public"
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Verify all metadata and committed assets; no fontTools required")
    parser.add_argument("--provenance", type=Path, default=Path(__file__).with_name("font-provenance.json"))
    parser.add_argument("--output", type=Path, default=public / "fonts/manrope")
    parser.add_argument("--source", type=Path, help="Oscar's exact Manrope[wght].ttf; required for generation")
    args = parser.parse_args()
    manifest = read_json(args.output / "fonts-manifest.json")
    source_gate(manifest, read_json(args.provenance))
    if args.check:
        check_outputs(manifest, args.output)
    else:
        if not args.source:
            parser.error("--source is required to generate subsets")
        verify_file(args.output / "OFL.txt", manifest["license"])
        build(args.source, manifest, args.output)
    print("Manrope provenance and five subset assets verified.")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, ImportError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
