{
  "name": "citadel-ops",
  "private": true,
  "version": "2.3.4",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "client:dev": "npm --prefix Client run dev",
    "client:build": "npm --prefix Client run build",
    "client:test": "npm --prefix Client test",
    "server:dev": "go run .",
    "build": "npm run client:build && go build -tags desktop -o CitadelOpsDesktop .",
    "build:server": "go build -o CitadelOpsDesktop .",
    "test": "go test ./... && npm run client:test"
  }
}
