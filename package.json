{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client:dev": "cd Client && npm run dev",
    "client:build": "cd Client && npm run build",
    "client:perf": "go run ./Tools/UIPerformance",
    "server:dev": "cd Server && go run main.go",
    "updateData": "go run ./Server/OfficialData -fetch-assets -prune-png",
    "serve": "npm run client:dev && npm run server:dev",
    "build": "npm run client:build && go build -o \"%USERPROFILE%\\Downloads\\CitadelOpsDesktop.exe\" .",
    "build:dev": "npm run client:build && go build -o CitadelDesktop.exe main.go && CitadelDesktop.exe"
  }
}
