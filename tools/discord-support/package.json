{
  "name": "citadel-ops-discord-support",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=25.9.0" },
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
